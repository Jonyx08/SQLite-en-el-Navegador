{
  "name": "sqlite-browser-ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "node --watch --experimental-strip-types src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc && tsc -p tsconfig.server.json && vite build",
    "start": "node --experimental-strip-types src/server/index.ts",
    "preview": "concurrently -k \"pnpm start\" \"vite preview\""
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3"
  }
}
